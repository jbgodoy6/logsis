      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DMAX}"
          },
          "rawSql": "select count(distinct charger_id) as \"Carregadores cadastrados\",count(distinct charger_id) filter(where online) as \"Carregadores online\",count(*) filter(where vehicle_state=1) as \"Veículos conectados\",count(*) filter(where alarm) as \"Conectores em alarme\" from dmax.v_ports where controller_id=${site:sqlstring}",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "canvas",
      "title": "$port",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DMAX}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DMAX}"
          },
          "rawSql": "select *,case when vehicle_state=1 then '../img/dmax/cable.svg' else '../img/dmax/cable-free.svg' end as cable_path,case when online then '../img/dmax/network.svg' else '../img/dmax/network-off.svg' end as network_path,case when equipment_state=3 then case when online then 'Alarme · ' else 'Último alarme · ' end ||coalesce(error_code,'Faulted') when not online then 'Estado não confirmado' when equipment_state=2 then 'Carregando' when equipment_state=1 then 'Cabo conectado · aguardando' else 'Cabo desconectado' end as state_label,case when last_plugged then case when online then '' else 'Último: ' end || vehicle_name else 'Sem veículo conectado' end as vehicle_label,communication_label||' · '||to_char(observed_at at time zone 'America/Sao_Paulo','HH24:MI:SS') as network_note from dmax.v_ports where controller_id=${site:sqlstring} and port_id=${port:sqlstring}",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
