          "rawSql": "select max(value) filter(where measurement='power_total_kw') as power, (select limit_kw from dmax.v_sites where controller_id=${site:sqlstring}) as site_limit, case when bool_and(fresh) then 'Medição atual' when bool_or(fresh) then 'Medição parcial' else 'Sem medição atual' end as meter_status from dmax.v_meter where controller_id=${site:sqlstring}",
