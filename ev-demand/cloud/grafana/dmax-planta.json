    {
      "id": 3,
      "type": "table",
      "title": "Todas as grandezas recebidas",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DMAX}"
      },
      "gridPos": {
        "x": 9,
        "y": 3,
        "w": 15,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DMAX}"
          },
          "rawSql": "select label as \"Grandeza\",value as \"Valor\",unit as \"Unidade\",case when fresh then 'Atual' else 'Indisponível' end as \"Qualidade\",sampled_at as \"Horário da leitura\" from dmax.v_meter where controller_id=${site:sqlstring} order by label",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "noValue": "—",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Parque da instalação",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DMAX}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
