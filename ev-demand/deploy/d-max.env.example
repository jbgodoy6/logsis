# Escuta local por padrão. Use túnel SSH para a primeira configuração.
DMAX_HOST=127.0.0.1
DMAX_PORT=8080
# Para disponibilizar em rede, configure certificado confiável e chave:
# DMAX_HOST=0.0.0.0
# DMAX_PORT=8443
# DMAX_TLS_CERT=/etc/d-max/certificado.pem
# DMAX_TLS_KEY=/etc/d-max/chave.pem
# Opcional: autenticação da sincronização com o serviço central.
# EV_CLOUD_TOKEN=defina-o-valor-seguramente-no-equipamento
