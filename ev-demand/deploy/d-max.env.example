# Nome, porta e host ficam em /etc/d-max/rede.ini.
# A primeira configuração de admin continua local, via túnel SSH.
# Opcional: estas variáveis têm precedência sobre rede.ini.
# DMAX_HOST=0.0.0.0
# DMAX_PORT=80
# Para disponibilizar em rede, configure certificado confiável e chave:
# DMAX_HOST=0.0.0.0
# DMAX_PORT=8443
# DMAX_TLS_CERT=/etc/d-max/certificado.pem
# DMAX_TLS_KEY=/etc/d-max/chave.pem
# Opcional: recuperação alternativa; não é necessária para root + palavra-passe.
# DMAX_RECOVERY_PUBLIC_KEY=/etc/d-max/recovery-public.pem
# Opcional: autenticação da sincronização com o serviço central.
# EV_CLOUD_TOKEN=defina-o-valor-seguramente-no-equipamento
# Demonstração exige token e endpoint separados do ambiente real.
# EV_DEMO_CLOUD_TOKEN=defina-outro-valor-seguramente-no-equipamento
# EV_DEMO_CONTROLLER_ID=demo-identificador-da-instalacao

# Opcional: chave do cadastro global, se preferir ambiente em vez da tela raiz.
# DMAX_DIRECTORY_TOKEN=defina-o-valor-seguramente-no-equipamento
