# Managed by EnergyCube D-Max installer.
[Unit]
Description=EnergyCube D-Max demand controller
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=dmax
Group=dmax
SupplementaryGroups=dialout
WorkingDirectory=/opt/d-max
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=EV_DB_PATH=/var/lib/d-max/controller.sqlite3
EnvironmentFile=/etc/d-max/d-max.env
ExecStart=/opt/d-max/.venv/bin/python /opt/d-max/run.py --config /etc/d-max/rede.ini
Restart=always
RestartSec=10
WatchdogSec=120
TimeoutStartSec=60
TimeoutStopSec=30
LimitCORE=0
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/d-max
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=d-max

[Install]
WantedBy=multi-user.target
